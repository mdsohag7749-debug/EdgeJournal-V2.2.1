# Copy this file to .env and fill in your Supabase project credentials.
# Supabase dashboard -> Project Settings -> API.
# Vite only exposes variables prefixed with VITE_ to client code.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# EdgeJournal AI — Sprint 9.6 (server-side provider bridge).
#
# Private credentials below are SERVER-ONLY (read by the /api/ai/* serverless
# functions in Node). Never prefix these with VITE_ — anything with VITE_ is
# bundled into the browser. Vite ignores non-VITE_ vars for the client.
# ---------------------------------------------------------------------------

# Public feature toggle for the client (browser only sees enabled/name).
# Set to true and provider to "remote" so the UI routes through OUR server.
VITE_AI_ENABLED=false
VITE_AI_PROVIDER=remote

# Server-side configuration (Vercel -> Project -> Environment Variables).
# Provider: Gemini Free Tier (lightweight Flash-Lite-class model, selected via
# GEMINI_MODEL). Verified on the official pricing page that the Free Tier
# covers Flash / Flash-Lite class models; do NOT hardcode a stale model id.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
# Future billing readiness — NOT enforced yet. free | pro | premium
AI_PLAN=free

# Optional: bind AI requests to the authenticated user's accounts (account
# isolation at the server). Needs the Supabase service role key.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
